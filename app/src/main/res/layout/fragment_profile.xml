<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg2"
    tools:context=".Profile">

    <!-- Header Background -->
    <View
        android:id="@+id/viewHeaderBackground"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/header_rounded_bg"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Content ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <!-- Profile Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="My Profile"
                android:textColor="@color/blue"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Profile Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProfileParams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="120dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="60dp"
                    android:paddingBottom="30dp"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="email@example.com"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp"/>

                    <View
                        android:layout_width="60dp"
                        android:layout_height="4dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="16dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Profile Picture Container (Overlapping) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="10dp"
                app:layout_constraintBottom_toTopOf="@id/cardProfileParams"
                app:layout_constraintEnd_toEndOf="@id/cardProfileParams"
                app:layout_constraintStart_toStartOf="@id/cardProfileParams"
                app:layout_constraintTop_toTopOf="@id/cardProfileParams">

                <!-- Profile Icon with Picture -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvProfilePicture"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivProfilePicture"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_background" />
                </androidx.cardview.widget.CardView>

                <!-- Profile Icon with Initials -->
                <TextView
                    android:id="@+id/tvInitials"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:text="UN"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/circle_background"
                    android:gravity="center"/>
            </FrameLayout>

            <!-- Info Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:padding="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/cardProfileParams">

                <!-- Qualification Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/pastel_blue">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Qualification"
                            android:textSize="12sp"
                            android:textColor="#546E7A"
                            android:textStyle="bold"/>
                        
                        <TextView
                            android:id="@+id/tvProfileEligibility"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Graduate"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#0277BD"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Age Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/layoutAge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/pastel_pink">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Age"
                            android:textSize="12sp"
                            android:textColor="#880E4F"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvProfileAge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="20"
                            android:gravity="center"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#C2185B"
                            android:layout_marginTop="4dp"/>
                            
                        <View android:id="@+id/dividerAge" android:layout_width="0dp" android:layout_height="0dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- DOB Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/layoutDOB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/pastel_mint">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date of Birth"
                            android:textSize="12sp"
                            android:textColor="#00695C"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvProfileDOB"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="02/09/2005"
                            android:gravity="center"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#004D40"
                            android:layout_marginTop="8dp"/>
                            
                         <View android:id="@+id/dividerDOB" android:layout_width="0dp" android:layout_height="0dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Stream Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/layoutStream"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/pastel_purple">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stream"
                            android:textSize="12sp"
                            android:textColor="#6A1B9A"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvProfileStream"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Science"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#4A148C"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>
            
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
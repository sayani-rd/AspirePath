<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg2">

    <!-- Toolbar removed or handled by parent if needed, but here we can keep a header title -->


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Post 10th Section -->
            <LinearLayout
                android:id="@+id/layoutPost10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post 10th Analysis"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interest Distribution"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_secondary"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartPost10"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="16dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <TextView
                        android:id="@+id/tvDescPost10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading analysis..."
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:padding="16dp"
                        android:lineSpacingExtra="4dp"/>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnViewPathPost10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 View My Career Path"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:backgroundTint="#1C4195"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Post 12th Section -->
            <LinearLayout
                android:id="@+id/layoutPost12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post 12th Analysis"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interest Distribution"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_secondary"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartPost12"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="16dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <TextView
                        android:id="@+id/tvDescPost12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading analysis..."
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:padding="16dp"
                        android:lineSpacingExtra="4dp"/>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnViewPathPost12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 View My Career Path"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:backgroundTint="#1C4195"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Post Graduation Section -->
            <LinearLayout
                android:id="@+id/layoutPostGrad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post Graduation Analysis"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interest Distribution"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_secondary"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartPostGrad"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="16dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <TextView
                        android:id="@+id/tvDescPostGrad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading analysis..."
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:padding="16dp"
                        android:lineSpacingExtra="4dp"/>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnViewPathPostGrad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 View My Career Path"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:backgroundTint="#1C4195"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No analysis data found. Take a quiz to see your results!"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:padding="32dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI &amp; Machine Learning Engineer"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp"/>

        <!-- What they do -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What they do"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tvJobDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="They build the brains behind automation..."
            android:textSize="14sp"
            android:textColor="#555555"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="12dp"/>

        <!-- Core Skills -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Core Skills"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_dark"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tvJobSkills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Python, PyTorch, Deep Learning..."
            android:textSize="14sp"
            android:textColor="#555555"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="12dp"/>

        <!-- Qualifications -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qualifications"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_orange_dark"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tvJobQualifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Degree in CS, Data Science..."
            android:textSize="14sp"
            android:textColor="#555555"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="12dp"/>

         <!-- Certifications -->
        <LinearLayout
            android:id="@+id/layoutCertifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Certifications"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_purple"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tvJobCertifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cloud Certs, etc..."
                android:textSize="14sp"
                android:textColor="#555555"
                android:lineSpacingMultiplier="1.2"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
